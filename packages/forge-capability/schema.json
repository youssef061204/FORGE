{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "forgecap/v1"
        },
        "manifest": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "name": {
              "type": "string",
              "maxLength": 100
            },
            "version": {
              "type": "string",
              "maxLength": 40
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "permissions": {
              "maxItems": 14,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 100
              }
            },
            "parentVersion": {
              "type": "string",
              "maxLength": 40
            }
          },
          "required": ["id", "name", "version", "createdAt", "permissions"],
          "additionalProperties": false
        },
        "spec": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "parentVersion": {
              "type": "string"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "intent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "trigger": {
              "type": "string",
              "enum": ["new_job_posting", "manual", "scheduled"]
            },
            "toolContract": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "inputSchema": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "outputSchema": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": ["name", "inputSchema", "outputSchema"],
              "additionalProperties": false
            },
            "nodes": {
              "minItems": 1,
              "maxItems": 24,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "posting.read",
                      "resume.read",
                      "posting.normalize",
                      "candidate.match",
                      "threshold.check",
                      "cover_letter.generate",
                      "document.write",
                      "notification.send",
                      "text.summarize",
                      "text.transform",
                      "light.read",
                      "light.set",
                      "door.read",
                      "door.lock",
                      "door.unlock",
                      "thermostat.read",
                      "thermostat.set",
                      "computer.read",
                      "computer.power",
                      "tv.read",
                      "tv.power",
                      "appliance.read",
                      "appliance.power",
                      "presence.read",
                      "presence.set",
                      "mailbox.read",
                      "energy.read",
                      "clock.read",
                      "clock.set",
                      "security.read",
                      "gmail.search",
                      "calendar.list",
                      "executable.run",
                      "calendar.update",
                      "calendar.create",
                      "notification.emit"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "dependsOn": {
                    "maxItems": 24,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    }
                  },
                  "config": {
                    "type": "object",
                    "properties": {
                      "threshold": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "comparison": {
                        "type": "string",
                        "enum": ["gte", "gt"]
                      },
                      "schemaVersion": {
                        "type": "string",
                        "enum": ["v1", "v2"]
                      },
                      "style": {
                        "type": "string",
                        "enum": ["concise", "uppercase", "lowercase"]
                      },
                      "rooms": {
                        "minItems": 1,
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "bedroom",
                            "office",
                            "kitchen",
                            "living",
                            "hallway"
                          ]
                        }
                      },
                      "on": {
                        "type": "boolean"
                      },
                      "temperature": {
                        "type": "number",
                        "minimum": 16,
                        "maximum": 28
                      },
                      "fallbackTemperature": {
                        "type": "number",
                        "minimum": 16,
                        "maximum": 28
                      },
                      "minAwayMinutes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1440
                      },
                      "presence": {
                        "type": "string",
                        "enum": ["home", "away"]
                      },
                      "timeOfDay": {
                        "type": "string",
                        "enum": ["day", "evening", "night"]
                      }
                    },
                    "additionalProperties": false
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 15000
                  },
                  "maxAttempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  }
                },
                "required": [
                  "id",
                  "operation",
                  "label",
                  "dependsOn",
                  "config",
                  "timeoutMs",
                  "maxAttempts"
                ],
                "additionalProperties": false
              }
            },
            "edges": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  }
                },
                "required": ["from", "to"],
                "additionalProperties": false
              }
            },
            "permissions": {
              "maxItems": 14,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "public_web.read",
                  "personal_resume.read",
                  "documents.write",
                  "notifications.write",
                  "world.read",
                  "world.lights.write",
                  "world.door.lock",
                  "world.door.unlock",
                  "world.climate.write",
                  "world.computer.write",
                  "world.tv.write",
                  "world.appliances.write",
                  "world.presence.write",
                  "world.clock.write",
                  "gmail.read",
                  "calendar.read",
                  "calendar.write",
                  "notification.emit"
                ]
              }
            },
            "policies": {
              "type": "object",
              "properties": {
                "approvalRequired": {
                  "type": "boolean",
                  "const": true
                },
                "network": {
                  "type": "string",
                  "const": "broker-only"
                },
                "maxRuntimeMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 30000
                },
                "maxToolCalls": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                },
                "maxRepairAttempts": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              },
              "required": [
                "approvalRequired",
                "network",
                "maxRuntimeMs",
                "maxToolCalls",
                "maxRepairAttempts"
              ],
              "additionalProperties": false
            },
            "reason": {
              "type": "string",
              "maxLength": 1000
            },
            "executable": {
              "type": "object",
              "properties": {
                "interface": {
                  "type": "string",
                  "const": "deadline/v1"
                },
                "language": {
                  "type": "string",
                  "const": "typescript"
                },
                "source": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 16000
                }
              },
              "required": ["interface", "language", "source"],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "name",
            "description",
            "version",
            "createdAt",
            "intent",
            "trigger",
            "toolContract",
            "nodes",
            "edges",
            "permissions",
            "policies",
            "reason"
          ],
          "additionalProperties": false
        },
        "artifact": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "enum": ["typescript", "ForgeSpec/1"]
            },
            "source": {
              "type": "string",
              "maxLength": 32000
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["language", "source", "hash"],
          "additionalProperties": false
        },
        "schemas": {
          "type": "object",
          "properties": {
            "input": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "output": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": ["input", "output"],
          "additionalProperties": false
        },
        "tests": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "evidence": {
          "type": "object",
          "properties": {
            "functionalPassed": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "functionalTotal": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "securityPassed": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "securityTotal": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "policy": {
              "type": "string",
              "const": "Evidence is portable; local trust and connector grants are not"
            }
          },
          "required": [
            "functionalPassed",
            "functionalTotal",
            "securityPassed",
            "securityTotal",
            "policy"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "maxLength": 200
            },
            "originalDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "exportedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": ["provider", "originalDigest", "exportedAt"],
          "additionalProperties": false
        },
        "dependencies": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "interface": {
                "type": "string",
                "maxLength": 100
              },
              "version": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": ["interface", "version"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "manifest",
        "spec",
        "artifact",
        "schemas",
        "tests",
        "evidence",
        "provenance",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "Ed25519"
            },
            "provider": {
              "type": "string",
              "const": "LOCAL DEVELOPMENT"
            },
            "publicKey": {
              "type": "string",
              "maxLength": 500
            },
            "value": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": ["algorithm", "provider", "publicKey", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "RSASSA_PSS_SHA_256"
            },
            "provider": {
              "type": "string",
              "const": "AWS KMS"
            },
            "publicKey": {
              "type": "string",
              "maxLength": 2000
            },
            "value": {
              "type": "string",
              "maxLength": 1000
            },
            "keyArn": {
              "type": "string",
              "maxLength": 300
            },
            "requestId": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "algorithm",
            "provider",
            "publicKey",
            "value",
            "keyArn",
            "requestId"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["payload", "contentHash", "signature"],
  "additionalProperties": false
}
