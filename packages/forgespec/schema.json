{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "parentVersion": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "trigger": {
      "type": "string",
      "enum": ["new_job_posting", "manual", "scheduled"]
    },
    "toolContract": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "inputSchema": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "outputSchema": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["name", "inputSchema", "outputSchema"],
      "additionalProperties": false
    },
    "nodes": {
      "minItems": 1,
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "operation": {
            "type": "string",
            "enum": [
              "posting.read",
              "resume.read",
              "posting.normalize",
              "candidate.match",
              "threshold.check",
              "cover_letter.generate",
              "document.write",
              "notification.send",
              "text.summarize",
              "text.transform",
              "light.read",
              "light.set",
              "door.read",
              "door.lock",
              "door.unlock",
              "thermostat.read",
              "thermostat.set",
              "computer.read",
              "computer.power",
              "tv.read",
              "tv.power",
              "appliance.read",
              "appliance.power",
              "presence.read",
              "presence.set",
              "mailbox.read",
              "energy.read",
              "clock.read",
              "clock.set",
              "security.read",
              "gmail.search",
              "calendar.list",
              "executable.run",
              "calendar.update",
              "calendar.create",
              "notification.emit",
              "city.observe",
              "city.apply"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "dependsOn": {
            "maxItems": 24,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "config": {
            "type": "object",
            "properties": {
              "threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "comparison": {
                "type": "string",
                "enum": ["gte", "gt"]
              },
              "schemaVersion": {
                "type": "string",
                "enum": ["v1", "v2"]
              },
              "style": {
                "type": "string",
                "enum": ["concise", "uppercase", "lowercase"]
              },
              "rooms": {
                "minItems": 1,
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["bedroom", "office", "kitchen", "living", "hallway"]
                }
              },
              "on": {
                "type": "boolean"
              },
              "temperature": {
                "type": "number",
                "minimum": 16,
                "maximum": 28
              },
              "fallbackTemperature": {
                "type": "number",
                "minimum": 16,
                "maximum": 28
              },
              "minAwayMinutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440
              },
              "presence": {
                "type": "string",
                "enum": ["home", "away"]
              },
              "timeOfDay": {
                "type": "string",
                "enum": ["day", "evening", "night"]
              },
              "cityActions": {
                "maxItems": 11,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "road.close",
                    "road.open",
                    "signal.set",
                    "vehicle.route",
                    "vehicle.dispatch",
                    "population.route",
                    "shelter.activate",
                    "grid.allocate",
                    "grid.shed",
                    "building.mode",
                    "alert.broadcast"
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 50,
            "maximum": 15000
          },
          "maxAttempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        },
        "required": [
          "id",
          "operation",
          "label",
          "dependsOn",
          "config",
          "timeoutMs",
          "maxAttempts"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "required": ["from", "to"],
        "additionalProperties": false
      }
    },
    "permissions": {
      "maxItems": 14,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "public_web.read",
          "personal_resume.read",
          "documents.write",
          "notifications.write",
          "world.read",
          "world.lights.write",
          "world.door.lock",
          "world.door.unlock",
          "world.climate.write",
          "world.computer.write",
          "world.tv.write",
          "world.appliances.write",
          "world.presence.write",
          "world.clock.write",
          "gmail.read",
          "calendar.read",
          "calendar.write",
          "notification.emit",
          "city.read",
          "city.roads",
          "city.signals",
          "city.vehicles",
          "city.population",
          "city.shelters",
          "city.grid",
          "city.buildings",
          "city.alerts"
        ]
      }
    },
    "policies": {
      "type": "object",
      "properties": {
        "approvalRequired": {
          "type": "boolean",
          "const": true
        },
        "network": {
          "type": "string",
          "const": "broker-only"
        },
        "maxRuntimeMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "maxRepairAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "approvalRequired",
        "network",
        "maxRuntimeMs",
        "maxToolCalls",
        "maxRepairAttempts"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "executable": {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string",
          "enum": ["deadline/v1", "city/v1"]
        },
        "language": {
          "type": "string",
          "const": "typescript"
        },
        "source": {
          "type": "string",
          "minLength": 20,
          "maxLength": 16000
        }
      },
      "required": ["interface", "language", "source"],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000
        },
        "hard": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string",
                "enum": [
                  "exposedPeople",
                  "evacuationSeconds",
                  "congestion",
                  "hospitalPower",
                  "gridLoad",
                  "responseSeconds",
                  "energyDemand",
                  "evacuatedPeople",
                  "shelterOccupancy"
                ]
              },
              "operator": {
                "type": "string",
                "enum": ["lte", "gte"]
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 100000
              }
            },
            "required": ["metric", "operator", "value"],
            "additionalProperties": false
          }
        },
        "objectives": {
          "minItems": 1,
          "maxItems": 9,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": {
                "type": "string",
                "enum": [
                  "exposedPeople",
                  "evacuationSeconds",
                  "congestion",
                  "hospitalPower",
                  "gridLoad",
                  "responseSeconds",
                  "energyDemand",
                  "evacuatedPeople",
                  "shelterOccupancy"
                ]
              },
              "direction": {
                "type": "string",
                "enum": ["minimize", "maximize"]
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10
              }
            },
            "required": ["metric", "direction", "weight"],
            "additionalProperties": false
          }
        },
        "actions": {
          "minItems": 1,
          "maxItems": 11,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "road.close",
              "road.open",
              "signal.set",
              "vehicle.route",
              "vehicle.dispatch",
              "population.route",
              "shelter.activate",
              "grid.allocate",
              "grid.shed",
              "building.mode",
              "alert.broadcast"
            ]
          }
        },
        "forbiddenOutcomes": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "priorities": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "interpretation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "goal",
        "hard",
        "objectives",
        "actions",
        "forbiddenOutcomes",
        "priorities",
        "interpretation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "version",
    "createdAt",
    "intent",
    "trigger",
    "toolContract",
    "nodes",
    "edges",
    "permissions",
    "policies",
    "reason"
  ],
  "additionalProperties": false
}
