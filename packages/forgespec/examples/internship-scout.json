{
  "id": "internship-scout",
  "name": "Internship Scout",
  "description": "Monitor opportunities, compare requirements against a resume, and notify when the match qualifies.",
  "version": "1.0.0",
  "createdAt": "2026-10-07T23:29:12.341Z",
  "intent": "Whenever a new AI internship is posted, compare it against my resume and tell me if I'm a strong candidate.",
  "trigger": "new_job_posting",
  "toolContract": {
    "name": "internship_scout",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "jobPosting": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["eventId", "jobPosting"],
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "capabilityId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "eventId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["success", "failed", "ignored"]
        },
        "trace": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "outcome": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "capabilityId",
        "version",
        "eventId",
        "status",
        "trace",
        "outcome"
      ],
      "additionalProperties": {}
    }
  },
  "nodes": [
    {
      "id": "retrieve-posting",
      "operation": "posting.read",
      "label": "Read public posting",
      "dependsOn": [],
      "config": {},
      "timeoutMs": 3000,
      "maxAttempts": 2
    },
    {
      "id": "normalize-posting",
      "operation": "posting.normalize",
      "label": "Validate & normalize",
      "dependsOn": ["retrieve-posting"],
      "config": {
        "schemaVersion": "v1"
      },
      "timeoutMs": 3000,
      "maxAttempts": 1
    },
    {
      "id": "retrieve-resume",
      "operation": "resume.read",
      "label": "Read resume",
      "dependsOn": [],
      "config": {},
      "timeoutMs": 3000,
      "maxAttempts": 1
    },
    {
      "id": "score-match",
      "operation": "candidate.match",
      "label": "Compare requirements",
      "dependsOn": ["normalize-posting", "retrieve-resume"],
      "config": {},
      "timeoutMs": 3000,
      "maxAttempts": 1
    },
    {
      "id": "match-threshold",
      "operation": "threshold.check",
      "label": "Match ≥ 75%",
      "dependsOn": ["score-match"],
      "config": {
        "threshold": 75,
        "comparison": "gte"
      },
      "timeoutMs": 3000,
      "maxAttempts": 1
    },
    {
      "id": "notify",
      "operation": "notification.send",
      "label": "Deliver simulator notification",
      "dependsOn": ["match-threshold", "score-match"],
      "config": {},
      "timeoutMs": 3000,
      "maxAttempts": 1
    }
  ],
  "edges": [
    {
      "from": "retrieve-posting",
      "to": "normalize-posting"
    },
    {
      "from": "normalize-posting",
      "to": "score-match"
    },
    {
      "from": "retrieve-resume",
      "to": "score-match"
    },
    {
      "from": "score-match",
      "to": "match-threshold"
    },
    {
      "from": "match-threshold",
      "to": "notify"
    },
    {
      "from": "score-match",
      "to": "notify"
    }
  ],
  "permissions": [
    "notifications.write",
    "personal_resume.read",
    "public_web.read"
  ],
  "policies": {
    "approvalRequired": true,
    "network": "broker-only",
    "maxRuntimeMs": 15000,
    "maxToolCalls": 20,
    "maxRepairAttempts": 3
  },
  "reason": "New capability requested in natural language"
}
