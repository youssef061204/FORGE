{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:product": "tsx scripts/benchmark-product.ts",
    "verify:product:openapi": "tsx scripts/verify-product-public-read.ts",
    "test:product:e2e": "playwright test --config playwright.product.config.ts",
    "test:core:e2e": "playwright test --config playwright.core.config.ts",
    "benchmark:forge": "tsx scripts/benchmark-forge.ts",
    "benchmark:ml": "tsx scripts/benchmark-forge.ts --ml",
    "verify:lab": "tsx scripts/verify-lab.ts",
    "sandbox:city": "tsx scripts/check-city-docker.ts",
    "verify:city": "tsx scripts/verify-city.ts",
    "verify:city:aws": "tsx scripts/verify-city.ts --aws",
    "verify:live": "tsx scripts/verify-live-http.ts",
    "verify:http": "tsx scripts/verify-http.ts",
    "verify:bedrock": "tsx scripts/verify-bedrock.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "evaluate": "tsx scripts/evaluate.ts",
    "spec:export": "tsx scripts/export-spec.ts",
    "sandbox:build": "docker build -t forge-sandbox:local -f sandbox/Dockerfile sandbox",
    "sandbox:check": "tsx scripts/check-docker.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "capsule:verify": "tsx scripts/capsule-format.ts",
    "evaluate:trust": "tsx scripts/evaluate-trust.ts",
    "sandbox:module": "tsx scripts/check-executable-docker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-eventbridge": "^3.0.0",
    "@aws-sdk/client-kms": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/credential-providers": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ajv": "^8.20.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.0.0",
    "tsx": "^4.20.0",
    "vitest": "^4.0.0"
  }
