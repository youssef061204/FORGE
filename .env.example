DEMO_MODE=true
FORGE_RUNTIME_MODE=fixture
FORGE_FREE_ONLY=true
FORGE_INTERACTIVE_PROVIDER=local
FORGE_LOCAL_MODEL=qwen2.5:7b-instruct
FORGE_LOCAL_MODEL_URL=http://127.0.0.1:11435
# Use installed cached weights only. Start Ollama with OLLAMA_NO_CLOUD=1.
# Legacy MODEL_PROVIDER=demo|bedrock is supported; omit it when switching runtime mode.
STORE_PROVIDER=local
SANDBOX_PROVIDER=process
FORGE_DATA_DIR=./data
# Required for non-loopback / cloud access. Never place this in NEXT_PUBLIC_*.
# FORGE_API_TOKEN=
AWS_PROFILE=forge
AWS_REGION=ca-central-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Paid cloud adapters remain disabled by FORGE_FREE_ONLY=true, even if AWS mode
# or credentials are configured. Do not change this without separate authorization.
# STORE_PROVIDER=dynamodb
# DYNAMODB_TABLE=forge-state
# SANDBOX_PROVIDER=docker
# FORGE_EVENT_BUS=forge-events
# FORGE_LOG_GROUP=/forge/audit

# Optional Google connector; never NEXT_PUBLIC_*. See docs/GOOGLE.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3108/api/google/callback
# GOOGLE_CALENDAR_ID=
# GOOGLE_TRUSTED_SENDERS=
# Optional external vault encryption key, exactly 32 bytes as hex.
# FORGE_VAULT_KEY=
# Optional Capsule AWS services, only used when explicitly configured in AWS mode.
# FORGE_KMS_KEY_ID=
# FORGE_ARTIFACT_BUCKET=
