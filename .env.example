# FORGE runs entirely on this machine. Nothing here enables a paid or cloud service.
NEXT_TELEMETRY_DISABLED=1

# Local model (Ollama). FORGE detects 127.0.0.1:11434 and :11435 automatically;
# set these only to pin a choice. Only loopback addresses are accepted.
# FORGE_OLLAMA_URL=http://127.0.0.1:11435
# FORGE_MODEL=qwen2.5:7b-instruct

# Where FORGE keeps its SQLite store and tool outputs (default: ./.forge).
# FORGE_HOME=./.forge

# Required only when the server is reached from a non-loopback address.
# FORGE_OWNER_TOKEN=

# showcase = no model, no server state; builds play recorded/scripted tapes and
# tools run in the visitor's browser. Default: local.
# FORGE_MODE=local

# Custom TypeScript tools are off by default. "process" or "docker" enables them.
# FORGE_CUSTOM_CODE=off
